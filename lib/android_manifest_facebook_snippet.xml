<!-- ============================================================
     AndroidManifest.xml — Facebook SDK additions
     File: android/app/src/main/AndroidManifest.xml
     ============================================================ -->

<!-- 1) Inside <manifest> tag (top-level), add internet permission if not already there: -->
<uses-permission android:name="android.permission.INTERNET"/>

<!-- 2) Inside <application> tag, add these: -->

    <!-- Facebook App ID — replace YOUR_FACEBOOK_APP_ID with your actual ID -->
    <meta-data
        android:name="com.facebook.sdk.ApplicationId"
        android:value="@string/facebook_app_id"/>

    <!-- Facebook Client Token — replace YOUR_FACEBOOK_CLIENT_TOKEN -->
    <meta-data
        android:name="com.facebook.sdk.ClientToken"
        android:value="@string/facebook_client_token"/>

    <!-- Facebook Login Activity -->
    <activity
        android:name="com.facebook.FacebookActivity"
        android:configChanges="keyboard|keyboardHidden|screenLayout|screenSize|orientation"
        android:label="@string/app_name"/>

    <!-- Facebook Custom Tab Activity (for Chrome Custom Tab login) -->
    <activity
        android:name="com.facebook.CustomTabActivity"
        android:exported="true">
        <intent-filter>
            <action android:name="android.intent.action.VIEW"/>
            <category android:name="android.intent.category.DEFAULT"/>
            <category android:name="android.intent.category.BROWSABLE"/>
            <!-- Replace YOUR_FACEBOOK_APP_ID below -->
            <data android:scheme="fbYOUR_FACEBOOK_APP_ID"/>
        </intent-filter>
    </activity>

